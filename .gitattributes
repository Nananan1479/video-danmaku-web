# ─────────────────────────────────────────────
#  Git Attributes — CiliCili 项目
#  统一换行符策略 + 二进制文件标记 + 语言统计
# ─────────────────────────────────────────────

# ═══════════════════════════════════════════
# 默认：自动检测文本，统一 LF 换行
# ═══════════════════════════════════════════
* text=auto eol=lf

# ═══════════════════════════════════════════
# 前端 — 文本文件（显式声明 LF）
# ═══════════════════════════════════════════
*.js              text eol=lf
*.mjs             text eol=lf
*.cjs             text eol=lf
*.ts              text eol=lf
*.vue             text eol=lf
*.css             text eol=lf
*.scss            text eol=lf
*.less            text eol=lf
*.html            text eol=lf
*.json            text eol=lf
*.md              text eol=lf diff=markdown
*.graphql         text eol=lf
*.env             text eol=lf
*.env.*           text eol=lf

# ═══════════════════════════════════════════
# 后端 — 文本文件（显式声明 LF）
# ═══════════════════════════════════════════
*.java            text eol=lf diff=java
*.xml             text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.properties      text eol=lf
*.sql             text eol=lf

# ═══════════════════════════════════════════
# 配置 / 工程文件
# ═══════════════════════════════════════════
.gitattributes    text eol=lf
.gitignore        text eol=lf
.editorconfig     text eol=lf
*.toml            text eol=lf
Dockerfile        text eol=lf
*.dockerignore    text eol=lf

# ═══════════════════════════════════════════
# Shell 脚本 — 统一 LF
# ═══════════════════════════════════════════
*.sh              text eol=lf
*.bash            text eol=lf
*.zsh             text eol=lf

# ═══════════════════════════════════════════
# Windows 批处理 — 必须保持 CRLF
# ═══════════════════════════════════════════
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# ═══════════════════════════════════════════
# 图片 — 二进制，不参与 diff
# ═══════════════════════════════════════════
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.svg             binary
*.webp            binary
*.bmp             binary
*.psd             binary

# ═══════════════════════════════════════════
# 字体 — 二进制
# ═══════════════════════════════════════════
*.ttf             binary
*.woff            binary
*.woff2           binary
*.eot             binary
*.otf             binary

# ═══════════════════════════════════════════
# 音视频 — 二进制
# ═══════════════════════════════════════════
*.mp3             binary
*.wav             binary
*.ogg             binary
*.mp4             binary
*.webm            binary
*.avi             binary
*.mov             binary

# ═══════════════════════════════════════════
# 压缩 / 归档 — 二进制
# ═══════════════════════════════════════════
*.zip             binary
*.tar             binary
*.gz              binary
*.bz2             binary
*.7z              binary
*.rar             binary
*.jar             binary
*.war             binary

# ═══════════════════════════════════════════
# 锁文件 — 标记为自动生成，PR 中默认折叠
# ═══════════════════════════════════════════
package-lock.json  text eol=lf linguist-generated=true
yarn.lock          text eol=lf linguist-generated=true
pnpm-lock.yaml     text eol=lf linguist-generated=true
*.lock             text eol=lf linguist-generated=true

# ═══════════════════════════════════════════
# GitHub Linguist — 语言统计优化
# ═══════════════════════════════════════════
# 让 Vue SFC 被正确识别为 Vue 而非 HTML
*.vue             linguist-language=Vue

# ═══════════════════════════════════════════
# 导出 / 忽略 (GitHub 默认折叠 diff)
# ═══════════════════════════════════════════
# .gitattributes linguist-vendored
# .gitignore      linguist-vendored
# .editorconfig   linguist-vendored
